# Public site URL, used for canonical and Open Graph links
NEXT_PUBLIC_SITE_URL=https://www.lurvelleescapes.com

# Map tiles for the destinations page. The OpenStreetMap default is for development only;
# use a commercial provider in production, e.g. MapTiler:
# NEXT_PUBLIC_MAP_TILE_URL=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_KEY
# NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; MapTiler &copy; OpenStreetMap contributors
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=
